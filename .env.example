# Discord Bot Token (required)
BOT_TOKEN=

# Owner User IDs (comma-separated) - have full access
OWNER_IDS=

# Developer User IDs (comma-separated) - have full access like owners
DEV_IDS=

# Twitch API Credentials (for notifications)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Bot status
BOT_STATUS=
BOT_STATUS_TYPE=
